{
  "name": "minimal-file-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal file manager with React, Express and PostgreSQL metadata",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "server": "node backend/index.js",
    "frontend": "npm --prefix frontend run dev",
    "start": "node backend/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
